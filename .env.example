# ── Database ──────────────────────────────────────────────────────────────────
APP_DB_URL=sqlite+aiosqlite:///./app.db

# ── Redis / RQ ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Azure AI Search ───────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-api-key>
AZURE_SEARCH_INDEX=doc-rag-index

# ── LiteLLM / Azure AI Foundry ────────────────────────────────────────────────
LITELLM_BASE_URL=https://<your-litellm-gateway>/
LITELLM_API_KEY=<your-litellm-api-key>
LITELLM_CHAT_MODEL=azure/claude-sonnet-4
LITELLM_EMBED_MODEL=azure/text-embedding-3-large

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_DIMENSIONS=3072

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
